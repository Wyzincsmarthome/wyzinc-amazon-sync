# ==============================================
# Flask Application
# ==============================================
FLASK_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe
PORT=5000

# ==============================================
# Amazon SP-API Credentials (LWA only)
# ==============================================
# Since 2 Oct 2023 SP-API no longer requires AWS IAM / Sig V4 - only LWA tokens
# are needed. See https://developer-docs.amazon.com/sp-api/changelog/sp-api-will-no-longer-require-aws-iam-or-aws-signature-version-4
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
MARKETPLACE_ID=A1RKKUPIHCS9HS
SELLER_ID=your-seller-id-here

LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxx
LWA_CLIENT_SECRET=your-lwa-secret
LWA_REFRESH_TOKEN=Atzr|xxxxx

# ==============================================
# Visiotech Catalog (XLSX dropped by Visiotech)
