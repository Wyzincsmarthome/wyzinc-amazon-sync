# ==============================================
# Storage Configuration
# ==============================================
STORAGE_PROVIDER=local
# For S3 storage:
# STORAGE_PROVIDER=s3
# S3_BUCKET=wyzinc-amazon-data
# S3_REGION=eu-west-1
# S3_PREFIX=production

# ==============================================
# Feature Flags
# ==============================================
SIMULATE_MODE=true
# Brands to ignore (comma-separated)
BRAND_BLOCKLIST=Apple,Samsung,HP,Dell,Microsoft,Acer,Asus

# ==============================================
# Scheduled Sync Job (APScheduler)
# ==============================================
# Set to true to run the daily sync inside the Flask process.
SYNC_ENABLED=false
# Standard cron (m h dom mon dow), timezone Europe/Madrid. Default: every day at 06:00.
SYNC_CRON=0 6 * * *
# Where products come from: csv | visiotech
SYNC_SOURCE=csv
# Required when SYNC_SOURCE=csv. Path relative to project root.
SYNC_INPUT_FILE=data/inputs/products.csv

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
