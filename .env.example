# ==============================================
VISIOTECH_FILE=data/inputs/visiotech_connect.xlsx

# ==============================================
# Feature Flags
# ==============================================
SIMULATE_MODE=true
# Brands to ignore globally (comma-separated). Overrides any source-level allow list.
BRAND_BLOCKLIST=

# ==============================================
# Scheduled Sync Job (APScheduler)
# ==============================================
# Set to true to run the sync inside the Flask process on the cron below.
SYNC_ENABLED=false
# Standard cron (m h dom mon dow). Timezone is Europe/Madrid. Default: daily 06:00.
SYNC_CRON=0 6 * * *
# Where products come from: csv | visiotech
SYNC_SOURCE=visiotech
# Used only when SYNC_SOURCE=csv. Path relative to project root.
SYNC_INPUT_FILE=

# ==============================================
# Storage (optional - currently unused)
# ==============================================
STORAGE_PROVIDER=local

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
